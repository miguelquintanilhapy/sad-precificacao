<Window x:Class="magal.Views.CadastrarFuncionarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:magal.Views"
        Title="Criar Funcionário"
        Height="640"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4FA">

    <Window.Resources>
        <SolidColorBrush x:Key="AzulAero" Color="#131C49"/>
        <SolidColorBrush x:Key="AeroBorder" Color="#E2E8F0"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AzulAero}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                BorderBrush="{StaticResource AeroBorder}"
                                BorderThickness="1.5"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="MaxDropDownHeight" Value="102"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource AeroBorder}"/>
            <Setter Property="BorderThickness" Value="0.4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AzulAero}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="32,28">
        <TextBlock Text="Novo Funcionário"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource AzulAero}"
                   Margin="0,0,0,24"/>

        <TextBlock
                   Style="{StaticResource LabelStyle}"><Run Text="NOME"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
        <TextBox x:Name="TxtNome" g:CampoGuia.Texto="Ex.: Maria Silva"
                 Style="{StaticResource InputStyle}"
                 Margin="0,0,0,14"/>

        <TextBlock
                   Style="{StaticResource LabelStyle}"><Run Text="CARGO"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
        <ComboBox x:Name="ComboCargo" g:CampoGuia.Texto="Selecione o cargo"
                  Style="{StaticResource ComboStyle}"
                  DisplayMemberPath="nome"
                  SelectedValuePath="id_cargo"
                  Margin="0,0,0,14"
                  FontWeight="SemiBold"
                  MaxDropDownHeight="90">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="22"/>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <TextBlock
                   Style="{StaticResource LabelStyle}"><Run Text="NÍVEL"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
        <ComboBox x:Name="ComboNivel" g:CampoGuia.Texto="Selecione o nível"
                  Style="{StaticResource ComboStyle}"
                  Margin="0,0,0,14"
                  FontWeight="SemiBold">
            <ComboBoxItem Content="Júnior"/>
            <ComboBoxItem Content="Pleno"/>
            <ComboBoxItem Content="Sênior"/>
            <ComboBoxItem Content="Especialista"/>
        </ComboBox>

        <TextBlock
                   Style="{StaticResource LabelStyle}"><Run Text="TIPO VÍNCULO"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
        <ComboBox x:Name="ComboTipoVinculo" g:CampoGuia.Texto="Selecione o vínculo"
                  Style="{StaticResource ComboStyle}"
                  Margin="0,0,0,14"
                  FontWeight="SemiBold">
            <ComboBoxItem Content="CLT"/>
            <ComboBoxItem Content="PJ"/>
            <ComboBoxItem Content="Autônomo"/>
        </ComboBox>

        <TextBlock
                   Style="{StaticResource LabelStyle}"><Run Text="STATUS"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
        <ComboBox x:Name="ComboStatus" g:CampoGuia.Texto="Selecione o status"
                  Style="{StaticResource ComboStyle}"
                  Margin="0,0,0,24"
                  FontWeight="SemiBold">
            <ComboBoxItem Content="Ativo"/>
            <ComboBoxItem Content="Inativo"/>
        </ComboBox>

        <Button Content="SALVAR FUNCIONÁRIO"
                Style="{StaticResource PrimaryBtn}"
                Click="BtnSalvar_Click"/>
    </StackPanel>
</Window>